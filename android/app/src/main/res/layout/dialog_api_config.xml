<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/api_config_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/api_config_hint"
            android:textColor="@color/key_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/api_base_url_label"
            android:textColor="@color/key_text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/api_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:hint="https://api.deepseek.com/v1"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/key_text"
            android:textColorHint="@color/key_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/api_key_label"
            android:textColor="@color/key_text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:hint="sk-..."
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="@color/key_text"
            android:textColorHint="@color/key_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/api_model_label"
            android:textColor="@color/key_text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/api_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:hint="deepseek-chat"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/key_text"
            android:textColorHint="@color/key_text_secondary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/api_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/api_enabled_label"
            android:textColor="@color/key_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_api_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_accent"
            android:gravity="center"
            android:text="@string/api_save"
            android:textColor="@color/accent_text"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
