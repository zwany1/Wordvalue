<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/panel_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ai_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ai_panel_title"
            android:textColor="@color/key_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ai_mode_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_soft"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/key_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ai_clipboard_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="8dp"
        android:text="@string/ai_clipboard_hint"
        android:textColor="@color/key_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/ai_manual_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:hint="@string/ai_manual_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="3"
        android:padding="8dp"
        android:textColor="@color/key_text"
        android:textColorHint="@color/key_text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ai_replies_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ai_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:text="@string/ai_empty_replies"
                android:textColor="@color/key_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/ai_card_natural"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ai_tag_natural"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/style_natural"
                        android:textColor="@color/style_tag_natural"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/ai_text_natural"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textColor="@color/key_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ai_use_natural"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_accent"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="@string/ai_action_use"
                    android:textColor="@color/accent_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ai_card_gentle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ai_tag_gentle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/style_gentle"
                        android:textColor="@color/style_tag_gentle"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/ai_text_gentle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textColor="@color/key_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ai_use_gentle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_accent"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="@string/ai_action_use"
                    android:textColor="@color/accent_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ai_card_funny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ai_tag_funny"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/style_funny"
                        android:textColor="@color/style_tag_funny"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/ai_text_funny"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textColor="@color/key_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ai_use_funny"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_accent"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="@string/ai_action_use"
                    android:textColor="@color/accent_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ai_btn_recovery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_soft"
            android:gravity="center"
            android:text="@string/ai_action_recovery"
            android:textColor="@color/key_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ai_btn_autopilot"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_soft"
            android:gravity="center"
            android:text="@string/ai_action_autopilot"
            android:textColor="@color/key_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ai_btn_consult"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_soft"
            android:gravity="center"
            android:text="@string/ai_action_consult"
            android:textColor="@color/key_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ai_btn_refresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_soft"
            android:gravity="center"
            android:text="@string/ai_action_refresh"
            android:textColor="@color/key_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ai_btn_generate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_button_accent"
            android:gravity="center"
            android:text="@string/ai_action_generate"
            android:textColor="@color/accent_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ai_btn_keyboard"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_soft"
            android:gravity="center"
            android:text="@string/ai_action_keyboard"
            android:textColor="@color/key_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
